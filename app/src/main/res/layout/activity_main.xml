<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <android.opengl.GLSurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Center Reticle (瞄准准星) -->
    <ImageView
        android:id="@+id/ivReticle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_menu_crop"
        android:tint="@color/terminal_green"
        android:alpha="0.75" />

    <!-- Terminal Top HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="16dp"
        android:background="@color/terminal_dark"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 基金会特勤终端 H-P.E.D · SCP-742-J 追踪 ]"
            android:textColor="@color/terminal_green"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="正在校准地面基准..."
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvEntityState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="实体状态: 未初始化"
            android:textColor="@color/terminal_green"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="已锁定地面: 0 | 帧率: -- FPS"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/terminal_border" />

        <!-- Detector Readout -->
        <TextView
            android:id="@+id/tvDetectorHaptics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="探测: 距离 --m | 锁定率 -- | 奇术通量 I = 0.00"
            android:textColor="@color/terminal_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Spatial Audio Readout -->
        <TextView
            android:id="@+id/tvSpatialAudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="声源: [盲爪爬行] | 方位: -- | 声道: L 0.00 | R 0.00"
            android:textColor="@color/white"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom Controls & Parameter Tuning -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:background="@color/terminal_dark"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Row 1: k selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="指向收束 k: "
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnK1"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/terminal_dark"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="k=1"
                android:textColor="@color/terminal_green"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnK2"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/terminal_green"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="k=2"
                android:textColor="@color/black"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnK4"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/terminal_dark"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="k=4"
                android:textColor="@color/terminal_green"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Row 2: Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnToggleFilter"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/terminal_green"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="滤镜: 终端视界"
                android:textColor="@color/black"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnToggleDebugMarker"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/terminal_dark"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="调试标点: 开"
                android:textColor="@color/terminal_green"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnRespawnEntity"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="0.8"
                android:backgroundTint="@color/terminal_dark"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="重置实体"
                android:textColor="@color/terminal_green"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="点击绿网地面投放实体；戴耳机盲搜听取走位"
            android:textColor="@color/white"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Permission prompt fallback -->
    <LinearLayout
        android:id="@+id/permissionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@color/terminal_dark"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/camera_permission_required"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnGrantPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/terminal_green"
            android:text="@string/grant_permission"
            android:textColor="@color/black" />
    </LinearLayout>

</FrameLayout>
